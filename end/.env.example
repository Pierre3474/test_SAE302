# ============================================================
# FICHIER .env.example — Template des variables d'environnement
# ============================================================
# Copiez ce fichier en .env et remplissez vos valeurs :
#   cp .env.example .env
# ============================================================

# --- Parametres du serveur PKI ---
SERVER_IP=127.0.0.1
SERVER_PORT=7890

# --- Chiffrement XOR (cle partagee avec le serveur) ---
XOR_KEY=42

# --- Parametres de cryptographie (CSR) ---
CSR_ORG=SAE302
CSR_COUNTRY=FR

# --- Parametres de stockage des cles ---
KEY_DIR=./keys
RSA_KEY_SIZE=2048

# --- Base de donnees PostgreSQL ---
POSTGRES_USER=sae302
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=sae302_pki
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- pgAdmin (interface web d'administration DB) ---
PGADMIN_MAIL=admin@sae302.local
PGADMIN_PW=change_me_pgadmin

# --- Mot de passe admin initial (seed au premier demarrage) ---
DEFAULT_ADMIN_PASSWORD=admin

# --- Interface web PKI ---
WEB_PORT=8080

# --- IPv6 (optionnel) ---
# SERVER_IPV6=0
# SERVER_IP_V6=::
