# ============================================================
# FICHIER .env.example — Template des variables d'environnement
# ============================================================
# Copiez ce fichier en .env et remplissez vos valeurs :
#   cp .env.example .env
# ============================================================

# --- Parametres du serveur PKI ---
SERVER_IP=127.0.0.1
SERVER_PORT=4567

# --- Parametres de cryptographie (CSR) ---
CSR_ORG=SAE302
CSR_COUNTRY=FR

# --- Parametres de stockage des cles ---
KEY_DIR=./keys
RSA_KEY_SIZE=2048
